<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:id="@+id/clientCardLayout"
    android:layout_height="match_parent"
    android:background="#F5F9F5">

    <!-- HEADER -->
    <androidx.cardview.widget.CardView
        android:id="@+id/headerCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="#FFFFFF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Clients"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="#1A2E1A"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Manage your loan clients"
                    android:textSize="13sp"
                    android:textColor="#6B7F6B"/>

            </LinearLayout>

            <!-- ADD CLIENT BUTTON -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddClient"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="0dp"

                android:text="+"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                app:cornerRadius="24dp"
                app:backgroundTint="#2E7D32"
                app:rippleColor="#80CBC4"
                android:elevation="2dp"/>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- SEARCH BAR -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/searchCard"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="16dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="#FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/headerCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_search"

                android:alpha="0.7"/>

            <EditText
                android:id="@+id/etSearchClient"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="Search client by name or phone..."
                android:singleLine="true"
                android:textSize="14sp"
                android:textColor="#1A2E1A"
                android:textColorHint="#9AAFA0"
                android:paddingStart="12dp"
                android:paddingEnd="8dp"/>



        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- CLIENT COUNT -->
    <LinearLayout
        android:id="@+id/clientCountContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/searchCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/txtClientCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="All Clients"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="#1A2E1A"/>

        <com.google.android.material.chip.Chip
            android:id="@+id/txtTotalClients"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3 clients"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            app:chipBackgroundColor="#2E7D32"
            app:chipStrokeColor="@null"
            app:chipCornerRadius="12dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            app:chipMinHeight="28dp"/>

    </LinearLayout>

    <!-- CLIENT LIST -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerClients"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:clipToPadding="false"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="20dp"
        app:layout_constraintTop_toBottomOf="@id/clientCountContainer"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>