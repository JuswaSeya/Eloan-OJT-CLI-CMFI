<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/clientCardItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="3dp"
    app:cardBackgroundColor="#FFFFFF"
    app:rippleColor="#2E7D3220"
    android:foreground="?android:attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp">

        <!-- PROFILE AVATAR -->
        <FrameLayout
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_client_avatar_green">

            <TextView
                android:id="@+id/txtClientInitial"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="JD"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:fontFamily="sans-serif-medium"/>

            <!-- Status indicator dot -->
            <View
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_gravity="bottom|end"
                android:background="@drawable/bg_status_active"
                android:layout_marginBottom="-4dp"
                android:layout_marginEnd="-4dp"/>

        </FrameLayout>

        <!-- CLIENT INFORMATION -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/txtClientName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Juan Dela Cruz"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#1A2E1A"
                    android:maxLines="1"
                    android:ellipsize="end"/>

                <!-- Loan status chip -->
                <com.google.android.material.chip.Chip
                    android:id="@+id/txtClientLoan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Active"
                    android:textSize="9sp"
                    android:textColor="#FFFFFF"
                    app:chipBackgroundColor="#2E7D32"
                    app:chipStrokeColor="@null"
                    app:chipCornerRadius="10dp"
                    app:chipMinHeight="20dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:layout_marginStart="8dp"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_phone"
  />

                <TextView
                    android:id="@+id/txtClientContact"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0912 345 6789"
                    android:textSize="12sp"
                    android:textColor="#6B7F6B"
                    android:paddingStart="6dp"/>

                <View
                    android:layout_width="4dp"
                    android:layout_height="4dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_status_active"
                    android:backgroundTint="@color/black"
                    android:layout_marginEnd="10dp"/>

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_loan_green"
                    />

                <TextView
                    android:id="@+id/txtClientLoanType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Personal Loan"
                    android:textSize="12sp"
                    android:textColor="#6B7F6B"
                    android:paddingStart="6dp"/>

            </LinearLayout>

        </LinearLayout>

        <!-- BALANCE -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="vertical"
            android:paddingStart="8dp">

            <TextView
                android:id="@+id/txtClientBalanceLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Balance"
                android:textSize="10sp"
                android:textColor="#9AAFA0"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/txtClientBalance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="₱25,000"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#1A2E1A"
                android:fontFamily="sans-serif-medium"/>

            <TextView
                android:id="@+id/txtClientDueDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Due: Dec 15"
                android:textSize="9sp"
                android:textColor="#E65100"
                android:visibility="gone"/>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>